 }
 
+/* preview pane width persistence */
+static gboolean
+save_preview_pane_width_cb (gpointer user_data)
+{
+	NemoWindow *window = user_data;
+
+	window->details->preview_pane_width_handler_id = 0;
+
+	DEBUG ("Saving preview pane width: %d", window->details->preview_pane_width);
+
+	g_settings_set_int (nemo_window_state,
+			    NEMO_WINDOW_STATE_PREVIEW_PANE_WIDTH,
+			    window->details->preview_pane_width);
+
+	return FALSE;
+}
+
+static void
+preview_pane_size_allocate_callback (GtkWidget *widget,
+				     GtkAllocation *allocation,
+				     gpointer user_data)
+{
+	NemoWindow *window;
+
+	window = user_data;
+
+	if (window->details->preview_pane_width_handler_id != 0) {
+		g_source_remove (window->details->preview_pane_width_handler_id);
+		window->details->preview_pane_width_handler_id = 0;
+	}
+
+	if (allocation->width != window->details->preview_pane_width &&
+	    allocation->width > 1) {
+		window->details->preview_pane_width = allocation->width;
+
+		window->details->preview_pane_width_handler_id =
+			g_timeout_add (100, save_preview_pane_width_cb, window);
+	}
+}
+
+static void
+setup_preview_pane_width (NemoWindow *window)
+{
+	g_return_if_fail (window->details->content_preview_paned != NULL);
+
+	window->details->preview_pane_width =
+		g_settings_get_int (nemo_window_state,
+				    NEMO_WINDOW_STATE_PREVIEW_PANE_WIDTH);
+
+	if (window->details->preview_pane_width <= 0) {
+		window->details->preview_pane_width = 350; /* default width */
+	}
+
+	/* Only set position if preview pane is visible */
+	if (nemo_window_preview_pane_showing (window)) {
+		GtkAllocation allocation;
+		int target_position;
+		
+		gtk_widget_get_allocation (window->details->content_preview_paned, &allocation);
+		target_position = allocation.width - window->details->preview_pane_width;
+		
+		if (target_position > 100) { /* ensure main content has reasonable width */
+			gtk_paned_set_position (GTK_PANED (window->details->content_preview_paned), target_position);
+		}
+	}
+}
+
